# Supabase project (find these in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Used to build the OAuth/email-confirmation redirect URL (lib/site.ts).
# Set this in production; local dev falls back to the request's Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key (Project Settings > API > service_role) — server-only,
# NEVER expose with a NEXT_PUBLIC_ prefix. Used by lib/actions/vendor.ts to
# upload vendor documents and file the vendor_applications row during
# signup, since a brand-new signup may not have a session yet (email
# confirmation pending) for the owner-scoped RLS policies to check against.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# No email provider needed: new vendor applications are reviewed directly in
# Supabase rather than by notification email. Query
# public.vendor_applications_review (or the vendor_applications table) in
# the SQL Editor — see supabase/migrations/0005_vendor_application_review_view.sql
# for the view definition and ready-to-run approve/reject queries.

# Verta Delivery now lives inside this app (app/delivery/*) rather than as a
# separate service — see supabase/migrations/0006_create_delivery_module.sql
# for the data-model mapping. The delete-password gate on bulk order/expense
# deletes (lib/actions/delivery.ts) — same behavior as the original standalone
# app's shared delete password. Defaults to "SKY" if unset.
DELIVERY_DELETE_PASSWORD=SKY

# Twilio — SMS + WhatsApp for Delivery notifications (lib/notifications/twilio.ts).
# Account SID / Auth Token from the Twilio Console; TWILIO_SMS_FROM is a
# Twilio phone number you've purchased; TWILIO_WHATSAPP_FROM is a
# WhatsApp-enabled sender (the Sandbox number below works for testing without
# WhatsApp Business approval).
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_SMS_FROM=<your-twilio-phone-number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio SendGrid — email for Delivery notifications (lib/notifications/email.ts).
# Uses its own API key (starts with "SG."), separate from the Twilio
# Account SID/Auth Token above. SENDGRID_FROM_EMAIL must be a verified
# sender identity in your SendGrid account.
SENDGRID_API_KEY=<your-sendgrid-api-key>
SENDGRID_FROM_EMAIL=<your-verified-sender>@yourdomain.com
