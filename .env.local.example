# Copy this file to .env.local for local development, and set the same
# keys in Vercel → Project Settings → Environment Variables for deploys.
# Never commit .env.local (it's already in .gitignore).

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ — it bypasses Row Level
# Security entirely. Set it in Vercel as a server-side env var only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site URL -----------------------------------------------------------
# Used to build OAuth/email-confirmation redirect links. In production, set
# this to your real domain. Leave unset in Preview deployments if you want
# lib/site-url.ts to fall back to each preview's own generated host instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Delivery admin: destructive-action password ----------------------------
# Required to delete a delivery expense from /admin/delivery/expenses.
DELIVERY_DELETE_PASSWORD=choose-a-strong-shared-password

# --- Twilio (SMS + WhatsApp delivery-order notifications) -------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+15551234567

# --- Twilio SendGrid (email delivery-order notifications) -------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender identity/domain in SendGrid, or sends will fail.
SENDGRID_FROM_EMAIL=notifications@yourdomain.com
